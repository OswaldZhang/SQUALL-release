    }
   ],
   "source": [
    "plt.figure(figsize=(10, 10))\n",
    "plt.imshow(slide_q, cmap=cmap, vmin=vmin, vmax=vmax)\n",
    "plt.title(\"IFNGR1 – Squall (whole slide)\")\n",
    "plt.axis(\"off\")\n",
